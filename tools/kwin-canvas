#
# kwin-canvas from a terminal. The fallback when the canvas is open and the
# chord does not reach it, from a virtual terminal included.
#
#   kwin-canvas exit      step into the location under the screen centre
#   kwin-canvas cancel    back to where you were, nothing moved
#   kwin-canvas open      step out to the overworld (waits up to 10 s for the effect at login)
#   kwin-canvas toggle    step out, or in when the canvas is open
#   kwin-canvas status    whether the effect is loaded and the plugin answers
#   kwin-canvas reset     recentre the plane on where you are (canvas closed): the view becomes (0, 0), no window moves
#   kwin-canvas doctor    read-only health check: what is installed, loaded, bound, enabled
#   kwin-canvas plugincheck [--notify] [--after N]   is the pass-through plugin built for the running KWin (exit 1 if not)
#   kwin-canvas perf [--since WHEN] [--from FILE] [--week]   timings the effect wrote to the journal (--week: a line a day)
#   kwin-canvas check [--notify] [--after N]   the plugin check plus the effect's QML errors since boot (exit 1 on either)
#   kwin-canvas fix-plugin   rebuild the pass-through plugin in the checkout and install it (asks sudo)
#   kwin-canvas plugin-hook install|remove   rebuild the plugin by itself after every KWin update (a pacman hook; asks sudo)
#   kwin-canvas setup [--check]   the recommended KDE settings, one question each before any change (--check only lists)
#
# Commands travel the effect's debug channel: DebugCommand and DebugSeq in
# the [Effect-kwin-canvas] group of kwinrc, read by the effect when KWin
# reconfigures it. From a VT the session bus is found at the user's runtime
# directory; qdbus6 needs the bus and nothing else. `open` retries until the
# effect is loaded, so an autostart entry can run it before KWin is done.
#
# doctor and perf only read: no config write, no restart, no D-Bus call that
# changes anything on disk or in the session, so they are safe to run mid-game.
# One exception is worth knowing: doctor calls the plugin's Passthrough.load once,
# and that call advances the plugin's cpu sample window (the effect's own 2 s
# ladder reads the busy share since the previous call, so a doctor reading shortens
# the effect's next window once). Otherwise the call is read-only. doctor prints
# one OK, WARN, FAIL or INFO line per check (INFO is not counted: it says what
# cannot be known) and exits 1 on any FAIL. Tests point it at fixtures with
# DOCTOR_REPO (the source tree), DOCTOR_HOME (stands in for $HOME),
# DOCTOR_PLUGIN_DIR, and DOCTOR_KWIN_START and DOCTOR_PLASMA_START (epoch seconds
# a session process started). The install comparison needs diff and cmp (diffutils).
set -euo pipefail

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
    export DBUS_SESSION_BUS_ADDRESS
fi

# ---- doctor and perf: read-only ---------------------------------------------

DOCTOR_OK=0
DOCTOR_WARN=0
DOCTOR_FAIL=0

# verdict LEVEL TAG TEXT: one line per check, counted for the summary (INFO is not counted).
verdict() {
    case "$1" in
        OK) DOCTOR_OK=$((DOCTOR_OK + 1)) ;;
        WARN) DOCTOR_WARN=$((DOCTOR_WARN + 1)) ;;
        FAIL) DOCTOR_FAIL=$((DOCTOR_FAIL + 1)) ;;
    esac  # INFO is printed and not counted
    printf '%-4s  %-10s %s\n' "$1" "$2" "$3"
}

# ini_get FILE GROUP KEY [DEFAULT]: the last value KEY has in [GROUP] of a
# KConfig file. DEFAULT answers only when the key is absent: a key set to
# nothing (ButtonsOnRight=) is a real value and stays empty.
ini_get() {
    awk -v group="[$2]" -v key="$3" -v def="${4:-}" '
        /^\[/ { cur = $0; next }
        cur == group {
            i = index($0, "=")
            if (i > 1) {
                k = substr($0, 1, i - 1)
                sub(/\[\$[a-z]+\]$/, "", k)
                if (k == key) { val = substr($0, i + 1); found = 1 }
            }
        }
        END { print (found ? val : def) }' "$1" 2>/dev/null || echo "${4:-}"
}

# newest_mtime PATH: the latest modification time (epoch seconds) of any file under PATH.
newest_mtime() {
    find "$1" -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -n 1 | cut -d. -f1
}

# proc_start PID: the epoch second the process started, empty when it is gone.
proc_start() {
    local up
    up=$(ps -o etimes= -p "$1" 2>/dev/null | tr -d ' ')
    [ -n "$up" ] && echo $(( $(date +%s) - up ))
}

# session_start KWIN|PLASMA: when the live session's compositor or shell started.
session_start() {
    local pid="" override
    if [ "$1" = KWIN ]; then
        override=${DOCTOR_KWIN_START:-}
    else
        override=${DOCTOR_PLASMA_START:-}
    fi
    if [ -n "$override" ]; then echo "$override"; return 0; fi
    if [ "$1" = KWIN ] && command -v qdbus6 >/dev/null 2>&1; then
        pid=$(qdbus6 org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.GetConnectionUnixProcessID org.kde.KWin 2>/dev/null)
    fi
    case "$pid" in
        ''|*[!0-9]*)
            # The oldest of the user's own: a nest started later is never older than the session.
            if [ "$1" = KWIN ]; then
                pid=$(pgrep -o -x -u "$(id -u)" kwin_wayland 2>/dev/null)
            else
                pid=$(pgrep -o -x -u "$(id -u)" plasmashell 2>/dev/null)
            fi ;;
    esac
    [ -n "$pid" ] && proc_start "$pid"
}

# tree_diff SRC DST: what differs between the repo's package and the installed copy, as
# "differ PATH", "missing PATH" (in the repo, not installed) and "extra PATH" lines.
# Ground.qml is left out: the install copies it in from shared/, checked on its own.
tree_diff() {
    (cd "$1" && diff -rq -x Ground.qml . "$2" 2>/dev/null) | awk '
        /^Files \.\// { sub(/^Files \.\//, ""); sub(/ and .*/, ""); print "differ " $0; next }
        /^Only in \.:/ { sub(/^Only in \.: /, ""); print "missing " $0; next }
        /^Only in \.\// { sub(/^Only in \.\//, ""); sub(/: /, "/"); print "missing " $0; next }
        /^Only in / { sub(/^Only in /, ""); print "extra " $0 }'
}

# doctor_package TAG NAME SRC DST [SHARED]: one verdict for one installed package.
doctor_package() {
    local tag=$1 name=$2 src=$3 dst=$4 shared=${5:-} diffs n first
    if [ ! -d "$dst" ]; then
        verdict FAIL "$tag" "$name is not installed ($dst is missing): make install"
        return
    fi
    diffs=$(tree_diff "$src" "$dst")
    if [ -n "$shared" ] && ! cmp -s "$shared" "$dst/contents/ui/Ground.qml"; then
        diffs="${diffs:+$diffs
}differ contents/ui/Ground.qml"
    fi
    if [ -z "$diffs" ]; then
        verdict OK "$tag" "$name matches the repo ($dst)"
        return
    fi
    n=$(printf '%s\n' "$diffs" | wc -l)
    first=$(printf '%s\n' "$diffs" | head -n 3 | sed 's/^[a-z]* //' | paste -sd, - | sed 's/,/, /g')
    verdict WARN "$tag" "$name differs from the repo in $n file(s) ($first): make install, then relogin if main.qml is among them"
}

# plugin_built_for FILE: the KWin version a plugin was built for. KWin stamps its full
# version into every plugin's factory interface ("PluginFactoryInterface6.8.0") and
# refuses a plugin whose stamp is not its own, patch releases included.
plugin_built_for() {
    grep -a -o 'PluginFactoryInterface[0-9][0-9.]*' "$1" 2>/dev/null | head -1 | sed 's/^PluginFactoryInterface//'
}
# running_kwin: the KWin version this session runs (DOCTOR_KWIN_VERSION stands in for tests).
running_kwin() {
    if [ -n "${DOCTOR_KWIN_VERSION+x}" ]; then printf '%s' "$DOCTOR_KWIN_VERSION"; return; fi
    kwin_wayland --version 2>/dev/null | awk 'NR == 1 { print $NF }'
}
# plugin_mismatch: prints "BUILT KWIN FILE" and returns 0 when an installed canvas plugin carries
# a version other than the running KWin's; returns 1 when it matches, is absent, or either version
# cannot be read (an unknown is never reported as a mismatch).
plugin_mismatch() {
    local f found="" built kw
    for f in "${DOCTOR_PLUGIN_DIR:-/usr/lib/qt6/plugins/kwin/plugins}"/*canvas*.so; do
        [ -e "$f" ] && found=$f
    done
    [ -n "$found" ] || return 1
    built=$(plugin_built_for "$found"); kw=$(running_kwin)
    [ -n "$built" ] && [ -n "$kw" ] && [ "$built" != "$kw" ] || return 1
    printf '%s %s %s' "$built" "$kw" "$found"
}
doctor_plugin_version() {
    local m built kw found
    if m=$(plugin_mismatch); then
        read -r built kw found <<<"$m"
        verdict FAIL plugin "built for KWin $built but this is KWin $kw: KWin refuses it, so the grasp over windows, input pass-through and the pill's pin buttons are off. Run kwin-canvas fix-plugin (or make plugin, then as root: install -m 755 build/plugin/bin/kwin/plugins/$(basename "$found") $(dirname "$found")/), then relogin"
    else
        found=""
        for f in "${DOCTOR_PLUGIN_DIR:-/usr/lib/qt6/plugins/kwin/plugins}"/*canvas*.so; do [ -e "$f" ] && found=$f; done
        if [ -z "$found" ]; then
            verdict INFO plugin "no pass-through plugin installed (optional)"
        elif [ -z "$(plugin_built_for "$found")" ] || [ -z "$(running_kwin)" ]; then
            verdict INFO plugin "cannot read the plugin's or the running KWin's version, so no comparison"
        else
            verdict OK plugin "built for KWin $(plugin_built_for "$found"), the version running"
        fi
    fi
}

doctor_installed() {
    local repo=$1 data=$2 home=$3 cli built plugdir f found=""
    if [ -z "$repo" ]; then
        verdict WARN installed "no source tree to compare with (this copy runs outside a checkout): run it from the checkout's tools/ or set DOCTOR_REPO"
        return
    fi
    if ! command -v diff >/dev/null 2>&1 || ! command -v cmp >/dev/null 2>&1; then
        verdict WARN installed "diffutils missing, install comparison skipped (diff and cmp are needed; Arch: pacman -S diffutils)"
        return
    fi
    doctor_package installed "effect" "$repo/effect" "$data/kwin/effects/kwin-canvas" "$repo/shared/Ground.qml"
    doctor_package installed "wallpaper" "$repo/wallpaper" "$data/plasma/wallpapers/kwin-canvas-ground" "$repo/shared/Ground.qml"
    doctor_package installed "toggle applet" "$repo/applet" "$data/plasma/plasmoids/org.kde.kwin.canvas.toggle"
    doctor_package installed "decor applet" "$repo/applet-decor" "$data/plasma/plasmoids/org.kde.kwin.canvas.decor"
    doctor_package installed "decoration" "$repo/decoration" "$data/kwin/decorations/kwin-canvas-decoration"
    cli="$home/.local/bin/kwin-canvas"
    if [ ! -f "$cli" ]; then
        verdict FAIL installed "the CLI is not installed ($cli is missing): make install"
    # The install writes the checkout's path into its copy; that line is not a difference.
    elif cmp -s <(grep -v '^INSTALLED_FROM=' "$repo/tools/kwin-canvas") <(grep -v '^INSTALLED_FROM=' "$cli"); then
        verdict OK installed "the CLI matches the repo ($cli)"
    else
        verdict WARN installed "the CLI differs from the repo's tools/kwin-canvas: make install"
    fi
    plugdir=${DOCTOR_PLUGIN_DIR:-/usr/lib/qt6/plugins/kwin/plugins}
    built="$repo/build/plugin/bin/kwin/plugins/kwin_canvas_passthrough.so"
    for f in "$plugdir"/*canvas*.so; do
        [ -e "$f" ] && found=$f
    done
    if [ -z "$found" ]; then
        verdict WARN installed "the pass-through plugin is not installed in $plugdir (optional): make plugin, then as root: install -m 755 $built $plugdir/, then relogin"
    elif [ ! -f "$built" ]; then
        verdict OK installed "the plugin is installed ($found); no build in the repo to compare it with"
    elif cmp -s "$built" "$found"; then
        verdict OK installed "the plugin matches the repo's build ($found)"
    else
        verdict WARN installed "the plugin differs from the repo's build: as root: install -m 755 $built $found, then relogin"
    fi
}

# stale_check TAG NAME FILE SESSION-START ADVICE: one verdict: is FILE older than the process
# that would have loaded it.
stale_check() {
    local m
    m=$(stat -c %Y "$3" 2>/dev/null) || { verdict WARN "$1" "$2: $3 is missing"; return; }
    if [ "$m" -gt "$4" ]; then
        verdict WARN "$1" "$2 is newer than the session: $5"
    else
        verdict OK "$1" "$2 is older than the session, so what runs is what is installed"
    fi
}

doctor_session() {
    local data=$1 cfg=$2 kstart pstart ui_m ui_dir hot kwinrc_m plug f newest
    kstart=$(session_start KWIN)
    pstart=$(session_start PLASMA)
    ui_dir="$data/kwin/effects/kwin-canvas/contents/ui"
    if [ -z "$kstart" ]; then
        verdict WARN session "KWin is not running (or not answering on $DBUS_SESSION_BUS_ADDRESS): staleness not checked"
    else
        if [ -f "$ui_dir/main.qml" ]; then
            stale_check session "main.qml" "$ui_dir/main.qml" "$kstart" "relogin to load it"
        else
            verdict WARN session "main.qml is not installed: staleness not checked"
        fi
        if [ -f "$ui_dir/ui.qml" ]; then
            ui_m=$(stat -c %Y "$ui_dir/ui.qml")
            if [ "$ui_m" -le "$kstart" ]; then
                verdict OK session "ui.qml is older than the session"
            else
                # Whether the effect re-read ui.qml cannot be read from the files. A make hot
                # bumps HotRev in kwinrc, so a kwinrc older than ui.qml (or HotRev never bumped)
                # proves no hot reload followed; a newer kwinrc proves nothing, since any
                # setting change rewrites it.
                hot=$(ini_get "$cfg/kwinrc" Effect-kwin-canvas HotRev 0)
                kwinrc_m=$(stat -c %Y "$cfg/kwinrc" 2>/dev/null || echo 0)
                if [ "${hot:-0}" != 0 ] && [ "$kwinrc_m" -ge "$ui_m" ]; then
                    verdict INFO session "ui.qml is newer than the session; whether it was hot-loaded is unknown (a heuristic only: kwinrc was written after it and HotRev is $hot, but any setting change does that): make hot to be sure"
                else
                    verdict WARN session "ui.qml is newer than the session and no hot reload followed it: make hot, or relogin"
                fi
            fi
        fi
        [ -f "$ui_dir/logic.js" ] && stale_check session "logic.js" "$ui_dir/logic.js" "$kstart" "relogin to load it"
        plug=""
        for f in "${DOCTOR_PLUGIN_DIR:-/usr/lib/qt6/plugins/kwin/plugins}"/*canvas*.so; do
            [ -e "$f" ] && plug=$f
        done
        [ -n "$plug" ] && stale_check session "the plugin" "$plug" "$kstart" "relogin to load it (KWin loads plugins at start)"
    fi
    if [ -z "$pstart" ]; then
        verdict WARN session "plasmashell is not running: applet and wallpaper staleness not checked"
    else
        newest=$(newest_mtime "$data/plasma/plasmoids/org.kde.kwin.canvas.toggle")
        newest=$(printf '%s\n%s\n%s\n' "${newest:-0}" "$(newest_mtime "$data/plasma/plasmoids/org.kde.kwin.canvas.decor")" "$(newest_mtime "$data/plasma/wallpapers/kwin-canvas-ground")" | sort -n | tail -n 1)
        if [ "${newest:-0}" -gt "$pstart" ]; then
            verdict WARN session "an applet or the ground wallpaper is newer than plasmashell: restart plasmashell (kquitapp6 plasmashell; kstart plasmashell) or relogin"
        else
            verdict OK session "the applets and the ground wallpaper are older than plasmashell"
        fi
    fi
}

# shortcut_conflicts FILE: "KEY<TAB>action | action" for every active key sequence that
# two or more actions hold, at least one of them a Canvas action.
shortcut_conflicts() {
    awk '
        # kglobalshortcutsrc escapes twice: the file turns a backslash into two,
        # and the list inside the value turns a comma into backslash-comma.
        function unescape(s,   i, c, n, out) {
            out = ""; n = length(s)
            for (i = 1; i <= n; i++) {
                c = substr(s, i, 1)
                if (c == "\\" && i < n) {
                    i++; c = substr(s, i, 1)
                    if (c == "t") out = out "\t"
                    else if (c == "s" || c == "n" || c == "r") out = out " "
                    else if (c == "\\") out = out "\\"
                    else out = out "\\" c
                } else out = out c
            }
            return out
        }
        function fields(s, f,   i, c, n, k) {
            k = 1; f[1] = ""; n = length(s)
            for (i = 1; i <= n; i++) {
                c = substr(s, i, 1)
                if (c == "\\" && i < n) { i++; f[k] = f[k] substr(s, i, 1) }
                else if (c == ",") { k++; f[k] = "" }
                else f[k] = f[k] c
            }
            return k
        }
        # Meta+Ctrl+Space and Ctrl+Meta+Space are one chord.
        function norm(key,   rest, t, meta, ctrl, alt, shift) {
            rest = key; meta = ctrl = alt = shift = 0
            while (match(rest, /^[A-Za-z]+\+./)) {
                t = tolower(substr(rest, 1, RLENGTH - 2))
                if (t == "meta") meta = 1
                else if (t == "ctrl") ctrl = 1
                else if (t == "alt") alt = 1
                else if (t == "shift") shift = 1
                else break
                rest = substr(rest, RLENGTH)
            }
            return (meta ? "Meta+" : "") (ctrl ? "Ctrl+" : "") (alt ? "Alt+" : "") (shift ? "Shift+" : "") rest
        }
        /^\[/ { group = $0; next }
        /^[^#=]+=/ {
            i = index($0, "=")
            name = substr($0, 1, i - 1)
            if (name ~ /^_/) next
            nf = fields(unescape(substr($0, i + 1)), f)
            friendly = (nf >= 3 && f[3] != "") ? f[3] : name
            canvas = (name ~ /Canvas/ || friendly ~ /^Canvas/)
            m = split(f[1], keys, "\t")
            for (j = 1; j <= m; j++) {
                if (keys[j] == "" || keys[j] == "none") continue
                nk = norm(keys[j]); id = group "/" name
                if (seen[nk SUBSEP id]++) continue
                holders[nk] = holders[nk] (holders[nk] == "" ? "" : " | ") "\"" friendly "\""
                count[nk]++
                if (canvas) hascanvas[nk] = 1
                order[++n] = nk
            }
        }
        END {
            for (j = 1; j <= n; j++) {
                nk = order[j]
                if (done[nk]++ || count[nk] < 2 || !hascanvas[nk]) continue
                print nk "\t" holders[nk]
            }
        }' "$1" 2>/dev/null
}

doctor_shortcuts() {
    local cfg=$1 hits key who zoom zoom_src
    if [ ! -f "$cfg/kglobalshortcutsrc" ]; then
        verdict WARN shortcuts "$cfg/kglobalshortcutsrc is missing: nothing to check"
    else
        hits=$(shortcut_conflicts "$cfg/kglobalshortcutsrc")
        if [ -z "$hits" ]; then
            verdict OK shortcuts "no key sequence is active on a Canvas action and another action"
        else
            while IFS=$'\t' read -r key who; do
                verdict FAIL shortcuts "$key is bound to $who: rebind one in System Settings > Shortcuts"
            done <<EOF
$hits
EOF
        fi
    fi
    # The stock Zoom effect owns Meta+wheel, Meta+= and Meta+-, which the canvas wants too.
    # When KWin does not answer, kwinrc decides; an unset zoomEnabled counts as on, as KDE
    # ships the effect enabled.
    zoom=$(qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.isEffectLoaded zoom 2>/dev/null || true)
    zoom_src="KWin says $zoom"
    if [ -z "$zoom" ] || [ "$zoom" = "no session" ]; then
        zoom=$(ini_get "$cfg/kwinrc" Plugins zoomEnabled "")
        if [ -z "$zoom" ]; then
            zoom=true
            zoom_src="KWin did not answer and kwinrc has no zoomEnabled, so on as KDE ships it"
        else
            zoom_src="KWin did not answer; kwinrc zoomEnabled=$zoom"
        fi
    fi
    if [ "$zoom" = true ]; then
        verdict WARN shortcuts "KDE's Zoom effect is on (${zoom_src}) and owns Meta+wheel, Meta+= and Meta+-: turn it off yourself in System Settings > Desktop Effects (nothing here does)"
    else
        verdict OK shortcuts "KDE's Zoom effect is not on (${zoom_src}), so Meta+wheel, Meta+= and Meta+- are free"
    fi
}

# rung_of VALUE REDUCED MINIMAL BARE: the ladder's rung 0..3 for one channel, the way
# qualityFor in logic.js reads it. A reading outside 0..100 counts as absent.
rung_of() {
    case "$1" in ''|*[!0-9]*) echo 0; return ;; esac
    if [ "$1" -gt 100 ]; then echo 0
    elif [ "$1" -ge "$4" ]; then echo 3
    elif [ "$1" -ge "$3" ]; then echo 2
    elif [ "$1" -ge "$2" ]; then echo 1
    else echo 0; fi
}

# knob CFG KEY DEFAULT: one of the effect's hidden fidelity thresholds.
knob() {
    ini_get "$1/kwinrc" Effect-kwin-canvas "$2" "$3"
}

doctor_ladder() {
    local cfg=$1 mode reading cpu gpu mem rc rg rmem rung name gtxt body
    local cr cm cb gr gm gb mr mm mb
    mode=$(ini_get "$cfg/kwinrc" Effect-kwin-canvas QualityMode Auto)
    # One call. load() is not state-free: the plugin's cpu is the busy share since its previous
    # call (the effect's own, every 2 s while the overworld is open, or anyone's), and this call
    # moves that sample window forward. Calling it twice would also cut the effect's next window
    # short twice. So the cpu figure is the average since whoever asked last, and 0 when nobody
    # had asked since KWin started.
    reading=$(qdbus6 org.kde.KWin /KWinCanvas org.kde.kwin.canvas.Passthrough.load 2>/dev/null || true)
    case "$reading" in
        cpu=*) ;;
        *)
            verdict WARN ladder "the pass-through plugin does not answer (not installed, built for another KWin, or no session): the ladder has no reading (mode $mode)"
            return ;;
    esac
    cpu=${reading#cpu=}; cpu=${cpu%% *}
    mem=${reading#*mem=}; mem=${mem%% *}
    gpu=${reading#*gpu=}; gpu=${gpu%% *}
    cr=$(knob "$cfg" CpuReduced 60); cm=$(knob "$cfg" CpuMinimal 80); cb=$(knob "$cfg" CpuBare 95)
    gr=$(knob "$cfg" GpuReduced 60); gm=$(knob "$cfg" GpuMinimal 80); gb=$(knob "$cfg" GpuBare 95)
    mr=$(knob "$cfg" MemReduced 80); mm=$(knob "$cfg" MemMinimal 90); mb=$(knob "$cfg" MemBare 97)
    rc=$(rung_of "$cpu" "$cr" "$cm" "$cb")
    rg=$(rung_of "$gpu" "$gr" "$gm" "$gb")
    rmem=$(rung_of "$mem" "$mr" "$mm" "$mb")
    rung=$rc
    [ "$rg" -gt "$rung" ] && rung=$rg
    [ "$rmem" -gt "$rung" ] && rung=$rmem
    case "$rung" in 0) name=full ;; 1) name=reduced ;; 2) name=minimal ;; *) name=bare ;; esac
    gtxt="gpu $gpu (steps at $gr/$gm/$gb)"
    [ "$gpu" = -1 ] && gtxt="gpu not readable (no NVML)"
    body="cpu $cpu (steps at $cr/$cm/$cb; the average since the plugin was last asked), $gtxt, mem $mem (steps at $mr/$mm/$mb)"
    if [ "$mode" != Auto ]; then
        verdict OK ladder "mode $mode holds its rung whatever the load; live reading: $body"
    elif [ "$rung" -eq 0 ]; then
        verdict OK ladder "Auto mode, full fidelity now: $body"
    else
        verdict WARN ladder "Auto mode, the machine is busy: the overworld would run at rung $rung ($name): $body"
    fi
}

doctor_enabled() {
    local cfg=$1 on loaded theme lib left right c seen pill_only="" applet_only="" neither=""
    on=$(ini_get "$cfg/kwinrc" Plugins kwin-canvasEnabled "")
    loaded=$(qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.isEffectLoaded kwin-canvas 2>/dev/null || true)
    if [ "$on" = true ] && [ "$loaded" = false ]; then
        verdict FAIL enabled "the effect is enabled in kwinrc but KWin has not loaded it: check journalctl --user -b -g kwin-canvas, then relogin"
    elif [ "$on" = true ]; then
        verdict OK enabled "the effect is enabled in kwinrc (loaded in KWin: ${loaded:-no answer})"
    elif [ "$loaded" = true ]; then
        verdict WARN enabled "the effect is loaded now but kwinrc does not enable it (kwin-canvasEnabled: ${on:-unset}): it will not load at the next login"
    else
        verdict WARN enabled "the effect is not enabled (kwin-canvasEnabled: ${on:-unset}): make enable"
    fi
    theme=$(ini_get "$cfg/kwinrc" org.kde.kdecoration2 theme "")
    lib=$(ini_get "$cfg/kwinrc" org.kde.kdecoration2 library "")
    left=$(ini_get "$cfg/kwinrc" org.kde.kdecoration2 ButtonsOnLeft MS)
    right=$(ini_get "$cfg/kwinrc" org.kde.kdecoration2 ButtonsOnRight HIAX)
    # The pill draws X I A S M F B H and a spacer; the panel applet draws X I A S F B E and a
    # spacer (it has no menu or help call, the pill has no capture glyph).
    seen=""
    for c in $(printf '%s%s' "$left" "$right" | fold -w1); do
        case "$seen" in *"$c"*) continue ;; esac
        seen="$seen$c"
        case "$c" in
            X|I|A|S|F|B|_) ;;
            M|H) pill_only="$pill_only $c" ;;
            E) applet_only="$applet_only $c" ;;
            *) neither="$neither $c" ;;
        esac
    done
    local note="buttons left '$left' right '$right'"
    [ -n "$pill_only" ] && note="$note; only the pill draws:$pill_only (the applet skips them)"
    [ -n "$applet_only" ] && note="$note; only the applet draws:$applet_only (the pill has no glyph for it)"
    [ -n "$neither" ] && note="$note; neither draws:$neither"
    if [ "$theme" = kwin-canvas-decoration ]; then
        verdict OK enabled "decoration: kwin-canvas-decoration is in use, so the pill is drawn; $note"
    else
        verdict OK enabled "decoration: ${theme:-the default} ($lib), not the canvas decoration, so no pill; $note"
    fi
}

# REBUILD_AWK: an awk function, rebuild(), true for a "built" Perf line that shows a rebuild on
# the frame path: something built in at least 5 frames and in a tenth of the session's frames or
# more. A window that opens mid-flight builds its few items in one frame; a binding that rebuilds
# on the camera builds in most of them. A line from before the frames count (no frames=) counts
# when 20 items or more were built while moving.
REBUILD_AWK='function rebuild(   i, kv, mv, fr, of, hasfr) {
    mv = 0; fr = 0; of = 0; hasfr = 0
    for (i = 1; i <= NF; i++) { split($i, kv, "="); if (kv[1] == "moving") mv = kv[2] + 0; if (kv[1] == "frames") { fr = kv[2] + 0; hasfr = 1 } if (kv[1] == "of") of = kv[2] + 0 }
    if (hasfr) return fr >= 5 && fr * 10 >= of
    return mv >= 20
}'
# doctor_frames: the canvas's own frame timings, which the effect writes to the journal while
# its Perf setting is on: whether the canvas sessions since boot kept their frames on time and
# created no scene item while the camera or a drag was moving (a rebuild on the frame path, the
# kind that once made a zoomed-out overview run at 1.5 frames a second). DOCTOR_PERF_FILE reads
# a saved dump instead of the journal.
doctor_frames() {
    local src="" lines sessions slow built
    if [ -n "${DOCTOR_PERF_FILE:-}" ]; then
        src=$(cat "$DOCTOR_PERF_FILE" 2>/dev/null)
    elif command -v journalctl >/dev/null 2>&1; then
        src=$(journalctl --user -b -g "kwin-canvas perf: (ticks|built)" -o cat --no-pager 2>/dev/null)
    fi
    lines=$(printf '%s\n' "$src" | sed -n 's/.*kwin-canvas perf: //p')
    if [ -z "$lines" ]; then
        verdict INFO frames "no frame timings in the journal since boot (the effect writes them with its Perf setting on)"
        return
    fi
    sessions=$(printf '%s\n' "$lines" | grep -c '^ticks ')
    # Slow: a frame of 250 ms or more, or a p95 of 100 ms. A short session's p95 is nearly its
    # max, and one late frame in fifteen is not what this is for.
    slow=$(printf '%s\n' "$lines" | awk '/^ticks / { p = 0; m = 0
        for (i = 2; i <= NF; i++) { split($i, kv, "="); if (kv[1] == "p95") p = kv[2] + 0; if (kv[1] == "max") m = kv[2] + 0 }
        if (p >= 100 || m >= 250) n++ } END { print n + 0 }')
    built=$(printf '%s\n' "$lines" | awk "$REBUILD_AWK"' /^built / { if (rebuild()) n++ } END { print n + 0 }')
    if [ "$built" -gt 0 ]; then
        verdict WARN frames "$built canvas sessions since boot rebuilt scene items in many frames while the camera or a drag was moving: a rebuild on the frame path (kwin-canvas perf --since today shows the built line's kinds)"
    elif [ "$slow" -gt 0 ]; then
        verdict WARN frames "$slow of $sessions canvas sessions since boot had a frame of 250 ms or more, or a p95 of 100 ms (kwin-canvas perf --since today lists the late ticks)"
    else
        verdict OK frames "$sessions canvas sessions since boot kept their frames on time and rebuilt nothing on the frame path"
    fi
}

doctor() {
    set +e +o pipefail
    local home repo
    home=${DOCTOR_HOME:-$HOME}
    repo=$(find_repo)
    echo "kwin-canvas doctor (read-only): repo ${repo:-none}, home $home"
    doctor_installed "$repo" "$home/.local/share" "$home"
    doctor_plugin_version
    doctor_session "$home/.local/share" "$home/.config"
    doctor_shortcuts "$home/.config"
    doctor_ladder "$home/.config"
    doctor_enabled "$home/.config"
    doctor_frames
    doctor_qml
    echo "kwin-canvas doctor: $DOCTOR_OK ok, $DOCTOR_WARN warn, $DOCTOR_FAIL fail"
    [ "$DOCTOR_FAIL" -eq 0 ]
}

# perf [--since WHEN] [--from FILE]: the timings the effect writes to the journal as
# "kwin-canvas perf: EVENT key=value ...", as count, min, median, p95 and max per
# event and key. --from reads a saved journal dump instead of asking journalctl.
perf() {
    set +e +o pipefail
    local since="1 hour ago" from="" out lines other boot="-b"
    while [ $# -gt 0 ]; do
        case "$1" in
            --week) perf_week "${2:-}"; return $? ;;
            --since) since=${2:-}; [ -n "$since" ] || { echo "kwin-canvas: --since needs a value, like '30 min ago'"; exit 1; }; boot=""; shift 2 ;;
            --from) from=${2:-}; [ -n "$from" ] || { echo "kwin-canvas: --from needs a file"; exit 1; }; shift 2 ;;
            *) echo "kwin-canvas: perf takes --since WHEN or --from FILE, not '$1'"; exit 1 ;;
        esac
    done
    if [ -n "$from" ]; then
        [ -r "$from" ] || { echo "kwin-canvas: cannot read $from"; exit 1; }
        out=$(cat "$from")
        since="the start of $from"
    else
        command -v journalctl >/dev/null 2>&1 || { echo "kwin-canvas: journalctl is missing"; exit 1; }
        # An explicit --since may reach past the last boot; the default hour stays in this one.
        out=$(journalctl --user $boot --since "$since" -g "kwin-canvas perf" -o cat --no-pager 2>&1)
    fi
    lines=$(printf '%s\n' "$out" | sed -n 's/.*kwin-canvas perf: //p')
    other=$(printf '%s\n' "$out" | grep -v 'kwin-canvas perf: ' | grep -v '^-- No entries --$' | grep -v '^$')
    if [ -z "$lines" ]; then
        echo "kwin-canvas perf: no perf lines since $since."
        echo "Either the canvas was not opened in that window, or the running KWin loaded an effect"
        echo "build that does not write them (main.qml is only re-read at login)."
        [ -n "$other" ] && printf 'journalctl said: %s\n' "$other"
        return 0
    fi
    echo "kwin-canvas perf: $(printf '%s\n' "$lines" | wc -l) lines since $since"
    {
        printf '%s\n' "$lines" | awk '
            { n[$1]++
              for (i = 2; i <= NF; i++) {
                  eq = index($i, "=")
                  if (eq < 2) continue
                  v = substr($i, eq + 1)
                  if (v ~ /^-?[0-9]+(\.[0-9]+)?$/) print "V\t" $1 "\t" substr($i, 1, eq - 1) "\t" v
              }
            }
            END { for (e in n) print "N\t" e "\t-\t" n[e] }'
    } | sort -t "$(printf '\t')" -k2,2 -k3,3 -k4,4g | awk -F'\t' '
        function num(x) { return x + 0 }
        function fmt(x,   t) {
            if (x == int(x)) return sprintf("%d", x)
            t = sprintf("%.2f", x); sub(/0+$/, "", t); sub(/\.$/, "", t)
            return t
        }
        function flush(   mid, p) {
            if (cnt == 0) return
            mid = (cnt % 2) ? vals[(cnt + 1) / 2] : (vals[cnt / 2] + vals[cnt / 2 + 1]) / 2
            p = int(0.95 * cnt); if (p < 0.95 * cnt) p++
            printf "%-12s %-6s %5d %9s %9s %9s %9s\n", ev, key, cnt, fmt(vals[1]), fmt(mid), fmt(vals[p]), fmt(vals[cnt])
        }
        BEGIN { printf "%-12s %-6s %5s %9s %9s %9s %9s\n", "event", "key", "n", "min", "median", "p95", "max" }
        $1 == "N" { counts[$2] = $4; next }
        {
            if ($2 != ev || $3 != key) { flush(); ev = $2; key = $3; cnt = 0; delete vals }
            vals[++cnt] = num($4); has[ev] = 1
        }
        END {
            flush()
            for (e in counts) if (!(e in has)) printf "%-12s %-6s %5d\n", e, "-", counts[e]
        }'
    # The late ticks, one per line with the time, so a hitch can be matched to what the machine
    # was doing then (the cpu, gpu and mem are the effect's last readings, up to 2 s old).
    stalls=$(printf '%s\n' "$lines" | grep -c '^stall ')
    if [ "$stalls" -gt 0 ]; then
        echo
        echo "late ticks (60 ms or more), $stalls in all; the last 12:"
        if [ -n "$from" ]; then
            printf '%s\n' "$lines" | grep '^stall ' | tail -12 | sed 's/^/  /'
        else
            journalctl --user -b --since "$since" -g "kwin-canvas perf: stall" -o short-iso --no-pager 2>/dev/null \
                | sed -n 's/^\([0-9T:-]*\)[-+][0-9:]* [^ ]* [^ ]*: kwin-canvas perf: stall /  \1 /p' | tail -12
        fi
    fi
}

# perf_week [FILE]: the last seven days, a line a day: canvas sessions, the median first paint,
# the sessions with a frame of 250 ms or more, and the sessions that built scene items while
# moving. FILE (journalctl -o short-iso output) instead of the journal, for the tests.
perf_week() {
    set +e +o pipefail
    local src
    if [ -n "${1:-}" ]; then src=$(cat "$1" 2>/dev/null)
    else src=$(journalctl --user --since "7 days ago" -g "kwin-canvas perf: (first-paint|ticks|built)" -o short-iso --no-pager 2>/dev/null)
    fi
    if ! printf '%s\n' "$src" | grep -q "kwin-canvas perf: "; then
        echo "kwin-canvas perf: no perf lines in the last seven days (the effect writes them with its Perf setting on)"
        return 0
    fi
    printf '%s\n' "$src" | awk "$REBUILD_AWK"'
        /kwin-canvas perf: / {
            day = substr($1, 1, 10)
            ev = $0; sub(/.*kwin-canvas perf: /, "", ev)
            split(ev, f, " ")
            if (!(day in seen)) { seen[day] = 1; days[++nd] = day }
            if (f[1] == "first-paint") { split(f[2], kv, "="); fp[day, ++nfp[day]] = kv[2] + 0 }
            else if (f[1] == "ticks") {
                ses[day]++; p = 0; m = 0
                for (i = 2; i in f; i++) { split(f[i], kv, "="); if (kv[1] == "p95") p = kv[2] + 0; if (kv[1] == "max") m = kv[2] + 0 }
                if (p >= 100 || m >= 250) slow[day]++
            } else if (f[1] == "built") {
                if (rebuild()) bm[day]++
            }
        }
        END {
            printf "%-10s %8s %16s %6s %14s\n", "day", "sessions", "first paint p50", "slow", "built moving"
            for (d = 1; d <= nd; d++) {
                day = days[d]; n = nfp[day]
                for (i = 1; i <= n; i++) v[i] = fp[day, i]
                for (i = 2; i <= n; i++) { x = v[i]; j = i - 1; while (j > 0 && v[j] > x) { v[j + 1] = v[j]; j-- } v[j + 1] = x }
                med = n ? v[int((n + 1) / 2)] " ms" : "-"
                printf "%-10s %8d %16s %6d %14d\n", day, ses[day], med, slow[day], bm[day]
            }
        }'
}

# plugincheck [--notify] [--after SECONDS]: exit 1, with the reason, when the installed plugin was built for another
# KWin than the one running. --notify also raises a desktop notification, for a login autostart;
# --after waits first, so the notification daemon is up by then.
# qml_errors: "COUNT FIRST-LINE" for the errors the running KWin logged for the effect's QML
# files since boot (a type that does not resolve, a TypeError, a binding loop), or nothing.
# DOCTOR_JOURNAL_FILE reads a saved dump instead of the journal.
qml_errors() {
    local src
    if [ -n "${DOCTOR_JOURNAL_FILE:-}" ]; then src=$(cat "$DOCTOR_JOURNAL_FILE" 2>/dev/null)
    elif command -v journalctl >/dev/null 2>&1; then src=$(journalctl --user -b -g "kwin-canvas.*\.(qml|js)" -o cat --no-pager 2>/dev/null)
    fi
    printf '%s\n' "$src" | grep -aE "kwin-canvas[^ ]*/contents/ui/[A-Za-z]+\.(qml|js)[^ ]*:[0-9]+(:[0-9]+)?: " \
        | grep -aE "is not a type|Error|Binding loop|is not defined|Cannot assign|Unable to assign|not available" \
        | sed -E 's#^.*/contents/ui/##; s#\?rev=[0-9]+##' | sort -u | awk 'NR == 1 { first = $0 } END { if (NR) print NR " " first }'
}
doctor_qml() {
    local e n first
    e=$(qml_errors)
    if [ -z "$e" ]; then verdict OK qml "no QML error from the effect logged since boot"; return; fi
    n=${e%% *}; first=${e#* }
    verdict FAIL qml "$n distinct QML errors from the effect since boot, the first: $first (the canvas may be half built; reinstall from a good commit, make install, and relogin)"
}

# The checkout `make install` copied this CLI from, written in by the install: the installed copy
# lives in ~/.local/bin, away from it.
INSTALLED_FROM=""
# find_repo: the checkout this CLI belongs to, or DOCTOR_REPO, or nothing.
find_repo() {
    local self cand
    if [ -n "${DOCTOR_REPO:-}" ]; then echo "$DOCTOR_REPO"; return; fi
    self=$(readlink -f "$0" 2>/dev/null)
    for cand in "$(dirname "$self")/.." "${KWIN_CANVAS_REPO:-}" "$INSTALLED_FROM"; do
        [ -n "$cand" ] && [ -f "$cand/effect/metadata.json" ] && [ -f "$cand/VERSION" ] && { (cd "$cand" && pwd); return; }
    done
}

# fix-plugin: rebuild the pass-through plugin for the running KWin and install it. The one
# command a notification can name; the install asks for the password itself.
fix_plugin() {
    set +e +o pipefail
    local repo so dest=${DOCTOR_PLUGIN_DIR:-/usr/lib/qt6/plugins/kwin/plugins}
    repo=$(find_repo)
    if [ -z "$repo" ]; then
        echo "kwin-canvas: no checkout found. Run this from the checkout's tools/kwin-canvas, or set KWIN_CANVAS_REPO to it."
        return 1
    fi
    echo "kwin-canvas: building the plugin in $repo for KWin $(running_kwin)"
    make -C "$repo" -s plugin || { echo "kwin-canvas: the build failed (make deps lists what is missing)"; return 1; }
    so="$repo/build/plugin/bin/kwin/plugins/kwin_canvas_passthrough.so"
    [ -f "$so" ] || { echo "kwin-canvas: the build left no $so"; return 1; }
    echo "kwin-canvas: installing it into $dest (sudo asks for your password)"
    ${FIX_SUDO-sudo} install -m 755 "$so" "$dest/" || { echo "kwin-canvas: the install did not happen"; return 1; }
    echo "kwin-canvas: installed, built for KWin $(plugin_built_for "$dest/kwin_canvas_passthrough.so"). Log out and back in to load it."
}

# setup [--check]: walk through the KDE settings the README recommends. Each that differs is shown
# with what it does for the canvas and changed only on a "y"; --check lists and changes nothing.
# Conflicts that need a person (a shared shortcut) are reported, not touched. SETUP_CONFIG points
# at another config directory (the tests), SETUP_NO_RECONFIGURE skips asking KWin to reload.
setup() {
    set +e +o pipefail
    local only=0 cfg changed=0 pending=0 line file group key want why cur ans
    [ "${1:-}" = --check ] && only=1
    cfg=${SETUP_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}}
    echo "kwin-canvas setup: the recommended KDE settings for the canvas$([ $only = 1 ] && echo ", listed only")"
    # The list comes in on fd 3, so the answers are read from the person on stdin.
    while IFS='|' read -r file group key want why <&3; do
        [ -n "$file" ] || continue
        cur=$(ini_get "$cfg/$file" "$group" "$key" "")
        if [ "$cur" = "$want" ]; then
            printf '  ok    %-28s %s\n' "$key" "$want"
            continue
        fi
        pending=$((pending + 1))
        printf '  set?  %-28s %s -> %s: %s\n' "$key" "${cur:-unset}" "$want" "$why"
        [ $only = 1 ] && continue
        printf '        change it? [y/N] '
        read -r ans || ans=""
        case "$ans" in
            y|Y|yes)
                kwriteconfig6 --file "$cfg/$file" --group "$group" --key "$key" -- "$want" && changed=$((changed + 1))
                echo "        set" ;;
            *) echo "        left as it is" ;;
        esac
    done 3<<'LIST'
kwinrc|Windows|FocusPolicy|FocusFollowsMouse|resting on a window hands it the input
kwinrc|Windows|DelayFocusInterval|150|a pass-over does not steal the focus
kwinrc|Windows|AutoRaise|true|the window you rest on comes up, as the canvas raises a fly's landing
kwinrc|Windows|AutoRaiseInterval|300|the raise waits a beat after the focus
kwinrc|Windows|ClickRaise|false|a click in a window does not fight the canvas's own stacking
kwinrc|Effect-kwin-canvas|BorderActivate|1,3,5,7|the four screen corners open the canvas
kwinrc|Effect-kwin-canvas|BorderZoom|fit|a corner shows every window, fitted to that monitor
kwinrc|Plugins|zoomEnabled|false|KDE's Zoom effect owns Meta+wheel, Meta+= and Meta+-
kdeglobals|KDE|AnimationDurationFactor|1|the slide and the camera follow the global speed; 1 is what they are tuned at
LIST
    # What needs a person, said and not touched.
    if [ -f "$cfg/kglobalshortcutsrc" ]; then
        local hits k who
        hits=$(shortcut_conflicts "$cfg/kglobalshortcutsrc")
        while IFS=$'\t' read -r k who; do
            [ -n "$k" ] && printf '  fix   %s is bound to %s: rebind one in System Settings > Shortcuts\n' "$k" "$who"
        done <<<"$hits"
    fi
    local desks
    desks=$(ini_get "$cfg/kwinrc" Desktops Number 1)
    [ "$desks" != 1 ] && printf '  note  %s virtual desktops: the plane takes their place; one is recommended (System Settings > Virtual Desktops)\n' "$desks"
    if [ $only = 1 ]; then
        echo "kwin-canvas setup: $pending to change; run kwin-canvas setup to be asked about each"
        return 0
    fi
    if [ $changed -gt 0 ] && [ -z "${SETUP_NO_RECONFIGURE:-}" ]; then
        qdbus6 org.kde.KWin /KWin org.kde.KWin.reconfigure >/dev/null 2>&1
        echo "kwin-canvas setup: $changed changed, KWin reloaded its settings"
    else
        echo "kwin-canvas setup: $changed changed"
    fi
}

# plugin-hook install|remove: a pacman hook that rebuilds the plugin after every KWin install or
# upgrade (packaging/kwin-canvas-plugin.hook), and the root-owned script it runs, with this
# checkout, its owner and the plugin dir written in. Install also runs it once, so a plugin that
# is stale now is fixed in the same step. HOOK_DIR and HOOK_LIBDIR point elsewhere for the tests,
# FIX_SUDO replaces sudo.
plugin_hook() {
    set +e +o pipefail
    local repo hookdir=${HOOK_DIR:-/etc/pacman.d/hooks} libdir=${HOOK_LIBDIR:-/usr/local/lib/kwin-canvas}
    local dest=${DOCTOR_PLUGIN_DIR:-/usr/lib/qt6/plugins/kwin/plugins} sudo=${FIX_SUDO-sudo} tmp
    case "${1:-}" in
        install)
            repo=$(find_repo)
            [ -n "$repo" ] || { echo "kwin-canvas: no checkout found. Run this from the checkout's tools/kwin-canvas, or set KWIN_CANVAS_REPO to it."; return 1; }
            tmp=$(mktemp -d) || return 1
            sed -e "s|@REPO@|$repo|" -e "s|@OWNER@|$(id -un)|" -e "s|@DEST@|$dest|" \
                "$repo/packaging/kwin-canvas-rebuild-plugin.in" > "$tmp/rebuild-plugin"
            sed "s|/usr/local/lib/kwin-canvas/rebuild-plugin|$libdir/rebuild-plugin|" "$repo/packaging/kwin-canvas-plugin.hook" > "$tmp/kwin-canvas-plugin.hook"
            echo "kwin-canvas: installing the pacman hook into $hookdir and its script into $libdir (sudo asks for your password)"
            if $sudo install -D -m 755 "$tmp/rebuild-plugin" "$libdir/rebuild-plugin" \
                && $sudo install -D -m 644 "$tmp/kwin-canvas-plugin.hook" "$hookdir/kwin-canvas-plugin.hook"; then
                rm -rf "$tmp"
                echo "kwin-canvas: installed; every KWin update now rebuilds the plugin. Running it once now:"
                $sudo "$libdir/rebuild-plugin"
            else
                rm -rf "$tmp"
                echo "kwin-canvas: the hook was not installed"; return 1
            fi ;;
        remove)
            $sudo rm -f "$hookdir/kwin-canvas-plugin.hook" "$libdir/rebuild-plugin" && $sudo rmdir "$libdir" 2>/dev/null
            echo "kwin-canvas: the pacman hook is removed; after a KWin update run kwin-canvas fix-plugin" ;;
        *) echo "kwin-canvas: plugin-hook takes install or remove"; return 2 ;;
    esac
}

# check [--notify] [--after SECONDS]: the login check. The plugin's version against KWin's, and the
# effect's QML errors since boot, each a desktop notification with --notify. Exit 1 on either.
check() {
    set +e +o pipefail
    local notify=0 rc=0 e args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --notify) notify=1; args+=(--notify); shift ;;
            --after) sleep "${2:-0}"; shift 2 ;;
            *) echo "kwin-canvas: check takes --notify and --after SECONDS"; return 2 ;;
        esac
    done
    plugincheck "${args[@]}" || rc=1
    e=$(qml_errors)
    if [ -n "$e" ]; then
        rc=1
        local msg="The canvas logged ${e%% *} QML errors since login, so parts of it may not draw or answer. The first: ${e#* }. Run kwin-canvas doctor."
        echo "kwin-canvas: $msg"
        if [ "$notify" = 1 ] && command -v notify-send >/dev/null 2>&1; then
            notify-send -a kwin-canvas -i dialog-error "kwin-canvas is partly broken" "$msg" || true
        fi
    else
        echo "kwin-canvas: no QML error from the effect since boot"
    fi
    return $rc
}

plugincheck() {
    local m built kw found msg notify=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --notify) notify=1; shift ;;
            --after) sleep "${2:-0}"; shift 2 ;;
            *) echo "kwin-canvas: plugincheck takes --notify and --after SECONDS"; return 2 ;;
        esac
    done
    if m=$(plugin_mismatch); then
        read -r built kw found <<<"$m"
        msg="The kwin-canvas plugin is built for KWin $built but this is KWin $kw, so KWin refuses it: the grasp over windows and the pill's pin buttons are off. Run: kwin-canvas fix-plugin, then log in again (kwin-canvas plugin-hook install does this by itself after every KWin update)."
        echo "kwin-canvas: $msg"
        if [ "$notify" = 1 ] && command -v notify-send >/dev/null 2>&1; then
            notify-send -a kwin-canvas -i dialog-warning "kwin-canvas plugin out of date" "$msg" || true
        fi
        return 1
    fi
    echo "kwin-canvas: the plugin matches KWin, or is not installed"
}

case "${1:-}" in
    plugincheck) shift; plugincheck "$@"; exit $? ;;
    doctor) shift; doctor "$@"; exit $? ;;
    perf) shift; perf "$@"; exit $? ;;
    check) shift; check "$@"; exit $? ;;
    fix-plugin) shift; fix_plugin "$@"; exit $? ;;
    setup) shift; setup "$@"; exit $? ;;
    plugin-hook) shift; plugin_hook "$@"; exit $? ;;
esac

for tool in qdbus6 kreadconfig6 kwriteconfig6; do
    command -v "$tool" >/dev/null 2>&1 || { echo "kwin-canvas: $tool is missing (Arch: qt6-tools, kconfig)"; exit 1; }
done

loaded() {
    qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.isEffectLoaded kwin-canvas 2>/dev/null || echo "no session"
}

plugin() {
    qdbus6 org.kde.KWin /KWinCanvas org.kde.kwin.canvas.Passthrough.probe 2>/dev/null || echo "no"
}

# send DEBUG-COMMAND DESCRIPTION [WAIT-SECONDS]
# With a wait, polls isEffectLoaded every half second until it is true or the
# time is up, for an autostart entry that runs before KWin has loaded the effect.
send() {
    local state seq tries
    tries=$(( ${3:-0} * 2 ))
    state=$(loaded)
    while [ "$state" != true ] && [ "$tries" -gt 0 ]; do
        sleep 0.5
        tries=$((tries - 1))
        state=$(loaded)
    done
    case "$state" in
        true) ;;
        false) echo "kwin-canvas: the effect is not loaded in KWin"; exit 1 ;;
        *) echo "kwin-canvas: KWin did not answer on $DBUS_SESSION_BUS_ADDRESS"; exit 1 ;;
    esac
    seq=$(kreadconfig6 --file kwinrc --group Effect-kwin-canvas --key DebugSeq --default 0)
    seq=$((seq + 1))
    kwriteconfig6 --file kwinrc --group Effect-kwin-canvas --key DebugCommand "$1"
    kwriteconfig6 --file kwinrc --group Effect-kwin-canvas --key DebugSeq "$seq"
    qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.reconfigureEffect kwin-canvas >/dev/null
    echo "kwin-canvas: $2"
}

case "${1:-}" in
    exit)   send enter  "entering the location under the screen centre" ;;
    cancel) send cancel "back to where you were, nothing moved" ;;
    open)   send open   "stepping out to the overworld" 10 ;;
    toggle) send toggle "toggled" ;;
    reset)  send recentre "the plane recentred on where you are: the view is (0, 0) now, no window moved" ;;
    status) echo "kwin-canvas: effect loaded: $(loaded); pass-through plugin: $(plugin)" ;;
    -h|--help|help) sed -n 's/^#   \(kwin-canvas \)/\1/p' "$0"; exit 0 ;;
    *) sed -n 's/^#   \(kwin-canvas \)/\1/p' "$0"; exit 1 ;;
esac
