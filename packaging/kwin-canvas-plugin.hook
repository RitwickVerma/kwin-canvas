# Rebuilds the kwin-canvas pass-through plugin whenever KWin is installed or upgraded, so the
# plugin always matches the KWin the next login runs. Installed into /etc/pacman.d/hooks by
# `kwin-canvas plugin-hook install`, removed by `kwin-canvas plugin-hook remove`.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = kwin

[Action]
Description = Rebuilding the kwin-canvas plugin for the new KWin...
When = PostTransaction
Exec = /usr/local/lib/kwin-canvas/rebuild-plugin
