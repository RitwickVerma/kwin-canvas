# shellcheck's standing policy. The scenarios are sourced fragments with no
# shebang, so the shell is declared here instead of in every file.
shell=bash

# Word splitting is the point where the nest assembles its command lines
# ($(nest_env), the dependency lists): the expansions are meant to split.
disable=SC2046
